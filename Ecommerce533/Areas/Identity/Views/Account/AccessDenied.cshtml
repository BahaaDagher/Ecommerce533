@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="text-center">
        <div class="mb-4">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size: 5rem;"></i>
        </div>

        <h1 class="display-4 fw-bold text-danger">Access Denied</h1>

        <h4 class="mb-3">403 - Forbidden</h4>

        <p class="text-muted mb-4">
            Sorry, you don't have permission to access this page.
            Please contact the administrator if you believe this is a mistake.
        </p>

        <a href="/Customer/Home/Index" class="btn btn-primary px-4">
            <i class="bi bi-house-door me-2"></i>
            Back to Home
        </a>
    </div>
</div>
